# instalar.sh lo copia a /etc/caddy/Caddyfile.
# DOMINIO y DUCKDNS_TOKEN vienen de /etc/caddy/duckdns.env (EnvironmentFile del servicio).
{
	# Sin listener en :80: el certificado sale por DNS-01 y el 80 no está abierto.
	auto_https disable_redirects
	# Sin HTTP/3, así alcanza con abrir TCP 443.
	servers {
		protocols h1 h2
	}
}

{$DOMINIO} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}
	# /api/avisos/* solo lo usa el servicio de avisos por localhost: desde afuera no existe.
	respond /api/avisos* 404

	# Caddy no limita el tamaño del cuerpo por defecto (fotos).
	# flush_interval -1: sin buffering, para el tiempo real (SSE en /api/realtime).
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}
